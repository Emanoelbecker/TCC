<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Clientes</h1>
    <a href="/clientes/new" class="btn btn-primary">Cadastrar cliente</a>
</div>

<% if (clientes.length === 0) { %>
    <p>Nenhum cliente cadastrado.</p>
<% } else { %>
    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col">Nome</th>
                    <th scope="col">CPF/CNPJ</th>
                    <th scope="col">E-mail</th>
                    <th scope="col">Telefone</th>
                    <th scope="col">Ações</th>
                </tr>
            </thead>
            <tbody>
                <% clientes.forEach((cliente) => { %>
                    <tr>
                        <td><%= cliente.nome %></td>
                        <td><%= cliente.cpf || cliente.cnpj || '-' %></td>
                        <td><%= cliente.email || '-' %></td>
                        <td><%= cliente.telefone || '-' %></td>
                        <td class="text-nowrap">
                            <a href="/clientes/<%= cliente.idCliente %>" class="btn btn-sm btn-outline-primary">Detalhes</a>
                            <a href="/clientes/<%= cliente.idCliente %>/edit" class="btn btn-sm btn-outline-secondary">Editar</a>
                            <form action="/clientes/<%= cliente.idCliente %>?_method=DELETE" method="POST" class="d-inline"
                                onsubmit="return confirm('Excluir este cliente?');">
                                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
<% } %>