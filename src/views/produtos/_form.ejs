<% if (errors.length > 0) { %>
    <div class="alert alert-danger" role="alert">
        <ul class="mb-0">
            <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
        </ul>
    </div>
<% } %>

<div class="form-group">
    <label for="nome">Nome <span aria-hidden="true">*</span></label>
    <input class="form-control" id="nome" name="nome" maxlength="150" required value="<%= produto.nome || '' %>">
</div>
<div class="form-row">
    <div class="form-group col-md-4">
        <label for="dataLote">Data do lote</label>
        <input class="form-control" id="dataLote" name="dataLote" type="date" value="<%= produto.dataLote || '' %>">
    </div>
    <div class="form-group col-md-4">
        <label for="dataValidade">Data de validade</label>
        <input class="form-control" id="dataValidade" name="dataValidade" type="date" value="<%= produto.dataValidade || '' %>">
    </div>
    <div class="form-group col-md-4">
        <label for="dataFabricacao">Data de fabricação</label>
        <input class="form-control" id="dataFabricacao" name="dataFabricacao" type="date" value="<%= produto.dataFabricacao || '' %>">
    </div>
</div>
<div class="form-row">
    <div class="form-group col-md-6">
        <label for="valor">Valor</label>
        <input class="form-control" id="valor" name="valor" type="number" min="0" step="0.01" value="<%= produto.valor ?? '' %>">
    </div>
    <div class="form-group col-md-6">
        <label for="valorUnidade">Valor por unidade</label>
        <input class="form-control" id="valorUnidade" name="valorUnidade" type="number" min="0" step="0.01" value="<%= produto.valorUnidade ?? '' %>">
    </div>
</div>
<div class="form-group">
    <label for="foto">URL da foto</label>
    <input class="form-control" id="foto" name="foto" type="url" maxlength="2048" value="<%= produto.foto || '' %>">
</div>
<div class="form-group">
    <label for="observacao">Observação</label>
    <textarea class="form-control" id="observacao" name="observacao" rows="3"><%= produto.observacao || '' %></textarea>
</div>
<div class="form-group">
    <label for="ingredientes">Ingredientes</label>
    <textarea class="form-control" id="ingredientes" name="ingredientes" rows="4"><%= produto.ingredientes || '' %></textarea>
</div>
<button type="submit" class="btn btn-primary"><%= isEdit ? 'Salvar alterações' : 'Cadastrar produto' %></button>
<a href="/produtos" class="btn btn-link">Cancelar</a>