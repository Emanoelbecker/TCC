<% if (errors.length > 0) { %>
    <div class="alert alert-danger" role="alert">
        <ul class="mb-0">
            <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
        </ul>
    </div>
<% } %>

<div class="form-group">
    <label for="nome">Nome <span aria-hidden="true">*</span></label>
    <input class="form-control" id="nome" name="nome" maxlength="150" required value="<%= produto.nome || '' %>">
</div>
<div class="form-row">
    <div class="form-group col-md-6">
        <label for="valor">Valor</label>
        <input class="form-control" id="valor" name="valor" type="number" min="0" step="0.01" value="<%= produto.valor ?? '' %>">
    </div>
</div>
<div class="form-group">
    <label for="observacao">Observação</label>
    <textarea class="form-control" id="observacao" name="observacao" rows="3"><%= produto.observacao || '' %></textarea>
</div>
<div class="form-group">
    <label for="ingredientes">Ingredientes</label>
    <textarea class="form-control" id="ingredientes" name="ingredientes" rows="4"><%= produto.ingredientes || '' %></textarea>
</div>
<div class="form-group">
    <label for="foto">Foto do produto</label>
    <input class="form-control-file" id="foto" name="foto" type="file" accept="image/jpeg,image/png,image/webp,.jpg,.jpeg,.png,.webp">
    <small class="form-text text-muted">JPG, JPEG, PNG ou WEBP, com até 5 MB. A imagem é opcional.</small>
    <div class="mt-3">
        <img id="fotoPreview" class="img-thumbnail" style="max-width: 240px; max-height: 240px; <%= produto.foto ? '' : 'display:none;' %>" alt="Prévia da foto do produto" src="<%= produto.foto ? '/uploads/produtos/' + produto.foto : '' %>">
        <div>
            <button id="trocarFoto" type="button" class="btn btn-sm btn-outline-secondary mt-2">Trocar imagem</button>
            <button id="removerFoto" type="button" class="btn btn-sm btn-outline-danger mt-2">Remover imagem</button>
        </div>
        <input id="removerFotoCampo" type="hidden" name="removerFoto" value="0">
    </div>
</div>
<button type="submit" class="btn btn-primary"><%= isEdit ? 'Salvar alterações' : 'Cadastrar produto' %></button>
<a href="/produtos" class="btn btn-link">Cancelar</a>
<script>
(function () {
    const input = document.getElementById('foto');
    const preview = document.getElementById('fotoPreview');
    const removeFlag = document.getElementById('removerFotoCampo');
    const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
    let objectUrl;

    function clearPreview() {
        if (objectUrl) URL.revokeObjectURL(objectUrl);
        objectUrl = undefined;
        preview.removeAttribute('src');
        preview.style.display = 'none';
    }

    document.getElementById('trocarFoto').addEventListener('click', () => input.click());
    document.getElementById('removerFoto').addEventListener('click', () => {
        input.value = '';
        removeFlag.value = '1';
        clearPreview();
    });
    input.addEventListener('change', () => {
        const file = input.files && input.files[0];
        if (!file) return;
        if (!allowedTypes.includes(file.type)) {
            alert('Selecione uma imagem JPG, JPEG, PNG ou WEBP válida.');
            input.value = '';
            return;
        }
        if (file.size > 5 * 1024 * 1024) {
            alert('A imagem deve ter no máximo 5 MB.');
            input.value = '';
            return;
        }
        if (objectUrl) URL.revokeObjectURL(objectUrl);
        objectUrl = URL.createObjectURL(file);
        preview.src = objectUrl;
        preview.style.display = 'block';
        removeFlag.value = '0';
    });
})();
</script>