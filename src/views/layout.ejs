<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#8F3F19">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Parisienne&display=swap" rel="stylesheet">
    <title>Bolachas da Zaira</title>
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        :root {
            --ink: #8F3F19;
            --ink-soft: #703117;
            --accent: #DDB0AD;
            --sage: #89A77B;
            --canvas: #FFFDF8;
            --blush: #F0DAD4;
            --line: #DDB0AD;
            --text: #55372D;
            --muted: #7D655B;
        }

        h1, h2, h3, .navbar-brand, .card-header { font-family: "Parisienne", cursive; }
        p, label, input, button, table, .navbar-nav, .app-footer, .form-control { font-family: "DM Sans", sans-serif; }

        html { min-height: 100%; }
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            background: var(--canvas);
            color: var(--text);
            font-family: "DM Sans", sans-serif;
        }
        a { color: #17645a; }
        a:hover { color: #10483f; }
        a:focus-visible, button:focus-visible, input:focus-visible,
        select:focus-visible, textarea:focus-visible, summary:focus-visible {
            outline: 3px solid #e8a17f;
            outline-offset: 2px;
        }
        .skip-link {
            position: absolute;
            top: -100px;
            left: 1rem;
            z-index: 1100;
            padding: .65rem 1rem;
            background: #fff;
            color: var(--ink);
        }
        .skip-link:focus { top: 1rem; }
        .navbar {
            background: var(--ink);
            padding: .8rem max(1rem, calc((100vw - 1280px) / 2));
        }
        .navbar-brand {
            color: #fff !important;
            font-size: 1.35rem;
            font-weight: 700;
        }
        .brand-mark {
            display: inline-grid;
            width: 3.25rem;
            height: 3.25rem;
            margin-right: .55rem;
            border-radius: 6px;
            object-fit: contain;
        }
        .navbar .nav-link {
            color: #e0e9e5 !important;
            padding: .55rem .7rem;
        }
        .navbar .nav-link:hover, .navbar .nav-link:focus { color: #fff !important; }
        .navbar-toggler { border-color: #8aa39a; }
        .navbar-toggler-icon { filter: invert(1); }
        .navbar-text { color: #e0e9e5 !important; }
        .public-navbar {
            border-bottom: 1px solid #d9e1dc;
            background: #fff;
        }
        .public-navbar .navbar-brand { color: var(--ink) !important; }
        .public-navbar .nav-link { color: #43534e !important; }
        .public-navbar .nav-link:hover, .public-navbar .nav-link:focus { color: var(--ink) !important; }
        .public-navbar .nav-link[aria-current="page"] {
            color: var(--ink) !important;
            box-shadow: inset 0 -2px var(--accent);
        }
        .public-navbar .navbar-toggler { border-color: #9aaba3; }
        .public-navbar .navbar-toggler-icon { filter: none; }
        .app-main {
            flex: 1 0 auto;
            width: 100%;
            max-width: 1280px;
            margin: 0 auto;
            padding: 2rem 1.25rem 3rem;
        }
        .app-main h1, .app-main h2 { color: var(--ink); }
        .app-main h1 { font-size: 3rem; }
        .app-main h2 { font-size: 2.5rem; }
        .app-main .card {
            border: 1px solid var(--line);
            border-radius: 6px;
            box-shadow: 0 2px 10px rgba(24, 61, 58, .06);
        }
        .app-main .card-header { background: var(--blush); color: var(--ink); }
        .app-main .form-control {
            min-height: 42px;
            border-color: #b9c8c0;
            color: var(--text);
        }
        .app-main textarea.form-control { min-height: auto; }
        .app-main .form-control:focus {
            border-color: #28786c;
            box-shadow: 0 0 0 .2rem rgba(40, 120, 108, .18);
        }
        .app-main .table-responsive { border: 1px solid var(--line); border-radius: 5px; }
        .app-main .table { margin-bottom: 0; background: #fff; }
        .app-main .table thead th {
            background: #eaf0ec;
            border-bottom: 2px solid #b9c8c0;
            color: var(--ink);
            white-space: nowrap;
        }
        .app-main .table td, .app-main .table th { vertical-align: middle; }
        .app-main .btn-primary {
            border-color: var(--ink);
            background: var(--ink);
        }
        .app-main .btn-primary:hover { border-color: var(--ink-soft); background: var(--ink-soft); }
        .app-main .alert { text-align: left; }
        .app-footer {
            padding: 1rem 1.25rem;
            border-top: 1px solid var(--line);
            background: var(--blush);
            color: var(--muted);
            text-align: center;
        }
        .login-page {
            min-height: calc(100vh - 180px);
            align-items: center;
            margin-top: 0 !important;
            padding: 2rem 0;
        }
        .login-card {
            overflow: hidden;
            border: 1px solid rgba(143, 63, 25, .18);
            border-radius: 18px;
            background: rgba(255, 253, 248, .96);
            box-shadow: 0 18px 50px rgba(143, 63, 25, .14);
        }
        .login-card .card-header {
            padding: 1.8rem 1.25rem 1rem;
            border-bottom: 0;
            background: linear-gradient(135deg, var(--blush), rgba(240, 218, 212, .35));
        }
        .login-card .card-header h2 {
            margin: 0;
            color: var(--ink);
            font-size: 3rem;
            font-weight: 400;
        }
        .login-card .card-body { padding: 1.25rem 2rem 2rem; }
        .login-card .form-group label { margin-bottom: .35rem; color: var(--ink); font-weight: 600; }
        .login-card .form-control {
            border: 1px solid var(--line);
            border-radius: 8px;
            background: #fff;
        }
        .login-card .form-control:focus { border-color: var(--sage); box-shadow: 0 0 0 .2rem rgba(137, 167, 123, .22); }
        .login-card .btn-primary {
            margin-top: .5rem;
            border: 0;
            border-radius: 999px;
            background: var(--sage);
            color: #fff;
            font-weight: 700;
            letter-spacing: .02em;
        }
        .login-card .btn-primary:hover { background: #728f67; }
        .login-card .alert-danger {
            border: 1px solid var(--blush);
            border-radius: 8px;
            background: var(--blush);
            color: var(--ink);
        }
        @media (max-width: 575.98px) {
            .app-main { padding: 1.25rem .85rem 2rem; }
            .app-main h1 { font-size: 1.65rem; }
            .app-main .d-flex.justify-content-between { align-items: flex-start !important; gap: .75rem; }
            .app-main .d-flex.justify-content-between .btn { flex-shrink: 0; }
            .app-main .table { min-width: 600px; }
        }
        @media (prefers-reduced-motion: reduce) {
            *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
        }
    </style>
</head>
<body>
    <a class="skip-link" href="#main-content">Pular para o conteúdo</a>
    <% if (typeof publicPage !== 'undefined' && publicPage) { %>
        <%- include('partials/public-navbar', { currentPage: currentPage }) %>
    <% } else { %>
        <%- include('partials/navbar') %>
    <% } %>
    <main class="app-main" id="main-content" tabindex="-1">
        <% if (typeof successMessage !== 'undefined' && successMessage) { %>
            <div class="alert alert-success" role="status" aria-live="polite"><%= successMessage %></div>
        <% } %>
        <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
            <div class="alert alert-danger" role="alert" aria-live="assertive"><%= errorMessage %></div>
        <% } %>
        <%- body %>
    </main>
    <footer class="app-footer">
        <span>&copy; <%= new Date().getFullYear() %> Bolachas da Zaira</span>
    </footer>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>
