<style>
    .public-home {
        --home-ink: var(--ink);
        --home-muted: var(--muted);
        max-width: 1120px;
        margin: 0 auto;
    }
    .home-hero {
        display: grid;
        grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
        gap: clamp(2rem, 6vw, 5rem);
        align-items: center;
        padding: 1.5rem 0 3rem;
    }
    .home-copy { max-width: 490px; }
    .home-eyebrow {
        margin-bottom: .75rem;
        color: var(--sage);
        font-size: .78rem;
        font-weight: 700;
        letter-spacing: .14em;
        text-transform: uppercase;
    }
    .home-copy h1 {
        margin-bottom: 1rem;
        color: var(--home-ink);
        font-size: clamp(3rem, 6vw, 4.5rem);
        line-height: .98;
    }
    .home-copy p:not(.home-eyebrow) {
        margin-bottom: 0;
        color: var(--home-muted);
        font-size: 1.08rem;
        line-height: 1.8;
    }
    .home-photo {
        margin: 0;
        padding: .8rem;
        border: 1px solid rgba(143, 63, 25, .16);
        border-radius: 12px;
        background: #fff;
        box-shadow: 0 18px 45px rgba(143, 63, 25, .12);
        transform: rotate(1deg);
    }
    .home-photo img {
        display: block;
        width: 100%;
        aspect-ratio: 4 / 3;
        border-radius: 7px;
        object-fit: cover;
    }
    .home-navigation {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.25rem;
    }
    .home-nav-button {
        display: flex;
        min-height: 106px;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.4rem 1.6rem;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: linear-gradient(135deg, rgba(240, 218, 212, .55), rgba(255, 253, 248, .9));
        color: var(--home-ink);
        text-decoration: none;
        transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }
    .home-nav-button:hover {
        border-color: var(--sage);
        box-shadow: 0 8px 22px rgba(143, 63, 25, .1);
        color: var(--home-ink);
        text-decoration: none;
        transform: translateY(-2px);
    }
    .home-nav-button span:first-child {
        font-family: "Parisienne", cursive;
        font-size: 2rem;
        font-weight: 700;
    }
    .home-nav-arrow {
        color: var(--sage);
        font-size: 1.5rem;
        line-height: 1;
    }
    @media (max-width: 767.98px) {
        .home-hero {
            grid-template-columns: 1fr;
            gap: 1.75rem;
            padding: .5rem 0 2rem;
        }
        .home-copy h1 { font-size: clamp(2.8rem, 12vw, 4rem); }
        .home-photo { max-width: 600px; }
        .home-navigation { gap: .75rem; }
        .home-nav-button { min-height: 88px; padding: 1rem; }
        .home-nav-button span:first-child { font-size: 1.65rem; }
    }
    @media (max-width: 420px) {
        .home-navigation { grid-template-columns: 1fr; }
    }
    @media (prefers-reduced-motion: reduce) {
        .home-nav-button { transition: none; }
    }
</style>

<main class="public-home">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-copy">
            <p class="home-eyebrow">Bolachas artesanais · Torres, RS</p>
            <h1 id="home-title">Feitas à mão, para adoçar bons momentos</h1>
            <p>
                Cada bolacha é preparada com carinho e atenção aos detalhes,
                para transformar encontros e comemorações em lembranças especiais.
            </p>
        </div>
        <figure class="home-photo">
            <img src="/ImagemIndex.jpeg" alt="Seleção de bolachas artesanais">
        </figure>
    </section>

    <nav class="home-navigation" aria-label="Navegação principal">
        <a class="home-nav-button" href="/catalogo">
            <span>Produtos</span>
            <span class="home-nav-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <a class="home-nav-button" href="/sobre">
            <span>Sobre</span>
            <span class="home-nav-arrow" aria-hidden="true">&rarr;</span>
        </a>
    </nav>
</main>
