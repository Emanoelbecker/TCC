<style>
    .catalog-header { margin-bottom: 1.75rem; }
    .catalog-eyebrow {
        margin-bottom: .45rem;
        color: #a64f34;
        font-size: .78rem;
        font-weight: 700;
        text-transform: uppercase;
    }
    .catalog-header h1 { margin-bottom: .5rem; }
    .catalog-header p { max-width: 650px; margin-bottom: 0; color: #65736e; }
    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 235px), 1fr));
        gap: 1.25rem;
    }
    .product-card {
        overflow: hidden;
        border: 1px solid #d9e1dc;
        border-radius: 6px;
        background: #fff;
        box-shadow: 0 2px 10px rgba(24, 61, 58, .06);
        transition: transform .18s ease, box-shadow .18s ease;
    }
    .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 22px rgba(24, 61, 58, .12);
    }
    .product-image { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
    .product-image-placeholder {
        display: grid;
        aspect-ratio: 4 / 3;
        place-items: center;
        padding: 1rem;
        background: repeating-linear-gradient(135deg, #eef2ed 0 16px, #e5ebe5 16px 32px);
        color: #65736e;
        text-align: center;
        font-size: .9rem;
    }
    .product-image-placeholder span {
        padding: .45rem .7rem;
        border: 1px solid rgba(24, 61, 58, .16);
        border-radius: 4px;
        background: rgba(255,255,255,.84);
    }
    .product-card-body { padding: 1rem 1.05rem 1.1rem; }
    .product-card h2 { margin: 0 0 .45rem; font-size: 1.1rem; line-height: 1.35; }
    .product-price { margin-bottom: .55rem; color: #a64f34; font-size: 1.05rem; font-weight: 700; }
    .product-description, .product-ingredients { margin: 0; color: #65736e; line-height: 1.55; }
    .product-ingredients { margin-top: .55rem; font-size: .88rem; }
    .catalog-empty {
        padding: 2.5rem 1.25rem;
        border: 1px dashed #b9c8c0;
        border-radius: 6px;
        background: #fff;
        color: #65736e;
        text-align: center;
    }
    .catalog-empty h2 { margin-bottom: .5rem; font-size: 1.2rem; }
    .catalog-empty p { margin: 0; }
    @media (hover: none) {
        .product-card:hover { transform: none; box-shadow: 0 2px 10px rgba(24, 61, 58, .06); }
    }
    @media (prefers-reduced-motion: reduce) {
        .product-card { transition: none; }
    }
</style>

<header class="catalog-header">
    <p class="catalog-eyebrow">Catálogo</p>
    <h1>Nossos produtos</h1>
    <p>Conheça os produtos disponíveis.</p>
</header>

<% if (produtos.length) { %>
    <section class="product-grid" aria-label="Produtos disponíveis">
        <% produtos.forEach((produto) => { %>
            <article class="product-card">
                <% if (produto.foto) { %>
                    <img class="product-image" src="/uploads/produtos/<%= produto.foto %>" alt="Foto de <%= produto.nome %>">
                <% } else { %>
                    <div class="product-image-placeholder" role="img" aria-label="Imagem indisponível para <%= produto.nome %>">
                        <span>Imagem não disponível</span>
                    </div>
                <% } %>
                <div class="product-card-body">
                    <h2><%= produto.nome %></h2>
                    <p class="product-price">
                        <% if (produto.valor !== null && produto.valor !== undefined) { %>
                            <%= new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(Number(produto.valor)) %>
                        <% } else { %>
                            Preço sob consulta
                        <% } %>
                    </p>
                    <p class="product-description"><%= produto.observacao || 'Descrição não informada.' %></p>
                    <% if (produto.ingredientes) { %>
                        <p class="product-ingredients"><strong>Informações:</strong> <%= produto.ingredientes %></p>
                    <% } %>
                </div>
            </article>
        <% }); %>
    </section>
<% } else { %>
    <section class="catalog-empty" role="status">
        <h2>Nenhum produto disponível no momento</h2>
        <p>Volte em breve para conferir as novidades.</p>
    </section>
<% } %>