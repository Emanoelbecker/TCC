<h1><%= venda.idVenda ? 'Editar venda' : 'Cadastrar venda' %></h1>

<% if (errors.length > 0) { %>
    <div class="alert alert-danger" role="alert">
        <ul class="mb-0">
            <% errors.forEach((error) => { %><li><%= error %></li><% }) %>
        </ul>
    </div>
<% } %>

<% if (clientes.length === 0) { %>
    <div class="alert alert-warning" role="alert">
        Nenhum cliente cadastrado. <a href="/clientes/new">Cadastre um cliente</a> antes de criar a venda.
    </div>
<% } %>
<% if (produtos.length === 0) { %>
    <div class="alert alert-warning" role="alert">
        Nenhum produto cadastrado. <a href="/produtos/new">Cadastre um produto</a> antes de criar a venda.
    </div>
<% } %>

<form action="/vendas<%= venda.idVenda ? `/${venda.idVenda}?_method=PUT` : '' %>" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
        <label for="idCliente">Cliente <span aria-hidden="true">*</span></label>
        <select class="form-control" id="idCliente" name="idCliente" required>
            <option value="">Selecione um cliente</option>
            <% clientes.forEach((cliente) => { %>
                <option value="<%= cliente.idCliente %>" <%= String(venda.idCliente || '') === String(cliente.idCliente) ? 'selected' : '' %>>
                    <%= cliente.nome %><%= cliente.nomeFantasia ? ` (${cliente.nomeFantasia})` : '' %>
                </option>
            <% }) %>
        </select>
    </div>
    <div class="form-group">
        <label for="localEntrega">Local de entrega</label>
        <input class="form-control" id="localEntrega" name="localEntrega" maxlength="255" value="<%= venda.localEntrega || '' %>">
    </div>
    <div class="form-row">
        <div class="form-group col-md-6">
            <label for="dataPedido">Data do pedido <span aria-hidden="true">*</span></label>
            <input class="form-control" id="dataPedido" name="dataPedido" type="date" required value="<%= venda.dataPedido || '' %>">
        </div>
        <div class="form-group col-md-6">
            <label for="dataEntrega">Data de entrega</label>
            <input class="form-control" id="dataEntrega" name="dataEntrega" type="date" value="<%= venda.dataEntrega || '' %>">
        </div>
    </div>
    <div class="form-group">
        <label for="observacao">Observação</label>
        <textarea class="form-control" id="observacao" name="observacao" rows="4"><%= venda.observacao || '' %></textarea>
    </div>
    <fieldset class="form-group">
        <legend class="h5">Produtos da venda</legend>
        <div id="sale-items">
            <% (venda.itens && venda.itens.length ? venda.itens : [{ idProduto: '', quantidade: '1' }]).forEach((item, index) => { %>
                <div class="form-row align-items-end sale-item mb-2">
                    <div class="form-group col-md-6 mb-md-0">
                        <label for="idProduto-<%= index %>">Produto <span aria-hidden="true">*</span></label>
                        <select class="form-control product-select" id="idProduto-<%= index %>" name="idProduto[]" required>
                            <option value="">Selecione um produto</option>
                            <% produtos.forEach((produto) => { %>
                                <option value="<%= produto.idProduto %>" data-unit-price="<%= produto.valorUnidade ?? '' %>" <%= String(item.idProduto || '') === String(produto.idProduto) ? 'selected' : '' %>>
                                    <%= produto.nome %> - <%= produto.valorUnidade == null ? 'valor por unidade não informado' : `R$ ${produto.valorUnidade}` %>
                                </option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="form-group col-md-2 mb-md-0">
                        <label for="quantidade-<%= index %>">Quantidade <span aria-hidden="true">*</span></label>
                        <input class="form-control item-quantity" id="quantidade-<%= index %>" name="quantidade[]" type="number" min="1" step="1" required value="<%= item.quantidade || '1' %>">
                    </div>
                    <div class="form-group col-md-3 mb-md-0">
                        <span class="d-block small text-muted">Subtotal</span>
                        <output class="item-subtotal">R$ 0,00</output>
                    </div>
                    <div class="form-group col-md-1 mb-md-0">
                        <button type="button" class="btn btn-outline-danger remove-item" aria-label="Remover produto">Remover</button>
                    </div>
                </div>
            <% }) %>
        </div>
        <button type="button" class="btn btn-outline-secondary" id="add-item" <%= produtos.length === 0 ? 'disabled' : '' %>>Adicionar produto</button>
        <p class="mt-3 mb-0" aria-live="polite"><strong>Total previsto: <output id="sale-total">R$ 0,00</output></strong></p>
    </fieldset>
    <button type="submit" class="btn btn-primary" <%= clientes.length === 0 || produtos.length === 0 ? 'disabled' : '' %>><%= venda.idVenda ? 'Salvar alterações' : 'Cadastrar venda' %></button>
    <a href="<%= venda.idVenda ? `/vendas/${venda.idVenda}` : '/vendas' %>" class="btn btn-link">Cancelar</a>
</form>

<script>
    (() => {
        const items = document.getElementById('sale-items');
        const addButton = document.getElementById('add-item');
        const totalOutput = document.getElementById('sale-total');

        function formatCents(cents) {
            return `R$ ${cents / 100n},${String(cents % 100n).padStart(2, '0')}`;
        }

        function priceInCents(value) {
            const match = /^(\d+)(?:\.(\d{1,2}))?$/.exec(value);
            if (!match) return null;
            return BigInt(match[1]) * 100n + BigInt((match[2] || '').padEnd(2, '0'));
        }

        function refreshTotal() {
            let total = 0n;
            items.querySelectorAll('.sale-item').forEach((row) => {
                const select = row.querySelector('.product-select');
                const quantity = row.querySelector('.item-quantity').value;
                const price = priceInCents(select.selectedOptions[0]?.dataset.unitPrice || '');
                const subtotal = price !== null && /^\d+$/.test(quantity) && Number(quantity) > 0
                    ? price * BigInt(quantity)
                    : 0n;
                row.querySelector('.item-subtotal').textContent = formatCents(subtotal);
                total += subtotal;
            });
            totalOutput.textContent = formatCents(total);
        }

        function updateRowLabels() {
            items.querySelectorAll('.sale-item').forEach((row, index) => {
                row.querySelector('.product-select').id = `idProduto-${index}`;
                row.querySelector('label[for^="idProduto-"]').htmlFor = `idProduto-${index}`;
                row.querySelector('.item-quantity').id = `quantidade-${index}`;
                row.querySelector('label[for^="quantidade-"]').htmlFor = `quantidade-${index}`;
            });
        }

        items.addEventListener('input', refreshTotal);
        items.addEventListener('change', refreshTotal);
        items.addEventListener('click', (event) => {
            if (!event.target.matches('.remove-item')) return;
            if (items.querySelectorAll('.sale-item').length === 1) {
                const row = event.target.closest('.sale-item');
                row.querySelector('.product-select').selectedIndex = 0;
                row.querySelector('.item-quantity').value = '1';
            } else {
                event.target.closest('.sale-item').remove();
            }
            updateRowLabels();
            refreshTotal();
        });
        addButton.addEventListener('click', () => {
            const row = items.querySelector('.sale-item').cloneNode(true);
            row.querySelector('.product-select').selectedIndex = 0;
            row.querySelector('.item-quantity').value = '1';
            items.appendChild(row);
            updateRowLabels();
            refreshTotal();
        });
        refreshTotal();
    })();
</script>
